    "var_3d8f4595dfba": {
      "type": "variant",
      "label": "Café Artesano · Menú mural retro",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Bowlby+One+SC&family=Yellowtail&display=swap');\n\n.cafe-page {\n  --espresso: #351D16;\n  --coffee: #6F3724;\n  --yellow: #E4AE22;\n  --orange: #E5652C;\n  --beige: #F3DBA9;\n  --ivory: #FFF4D8;\n  --espresso-soft: rgba(53, 29, 22, .72);\n  --dark-line: rgba(255, 244, 216, .3);\n  --light-line: rgba(53, 29, 22, .28);\n  --yellow-soft: rgba(228, 174, 34, .78);\n  --orange-soft: rgba(229, 101, 44, .18);\n  --modal-shadow: rgba(53, 29, 22, .38);\n  font-family: 'Atkinson Hyperlegible', sans-serif;\n  scroll-behavior: smooth;\n}\n.font-bowlby { font-family: 'Bowlby One SC', sans-serif; }\n.font-yellowtail { font-family: 'Yellowtail', cursive; }\n.rail-marker { transition: top 160ms ease; }\n.product-action .action-mark { transition: transform 160ms ease; }\n.product-action:hover .action-mark,\n.product-action:focus-visible .action-mark { transform: translateX(4px); }\n.dialog-panel { opacity: 0; transform: translateY(8px); transition: opacity 160ms ease, transform 160ms ease; box-shadow: 0 18px 40px var(--modal-shadow); }\n.dialog-open .dialog-panel { opacity: 1; transform: translateY(0); }\n.dialog-open .dialog-backdrop { opacity: .82; }\n.no-scrollbar { scrollbar-width: none; }\n.no-scrollbar::-webkit-scrollbar { display: none; }\n.cafe-page :focus-visible { outline: 3px solid var(--espresso); outline-offset: 3px; }\n.cafe-page .dark-surface :focus-visible,\n.cafe-page aside :focus-visible { outline-color: var(--ivory); }\n.mobile-chapter-link[aria-current=\"page\"] { color: var(--orange); text-decoration-color: var(--orange); }\n@media (prefers-reduced-motion: reduce) {\n  .cafe-page { scroll-behavior: auto; }\n  .rail-marker, .product-action .action-mark, .dialog-panel { transition: none; }\n  .dialog-open .dialog-panel { transform: none; }\n}\nbody.dialog-open { overflow: hidden; }\n</style>\n<link data-kid=\"1\" data-name=\"google fonts stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"cafe-page min-h-screen overflow-x-clip bg-[var(--beige)] text-[var(--espresso)]\" data-kid=\"2\" data-name=\"cafe page layout container\" id=\"cafe-page\">\n    <aside aria-label=\"Navegación del menú\" class=\"dark-surface fixed inset-y-0 left-0 z-30 hidden w-[270px] flex-col justify-between bg-[var(--espresso)] px-7 py-7 text-[var(--ivory)] lg:flex\" data-kid=\"2-1\" data-name=\"sidebar navigation\">\n        <div data-kid=\"2-1-1\" data-name=\"sidebar menu wrapper\">\n            <a aria-label=\"Café Artesano\" class=\"mb-12 flex h-[78px] w-[154px] items-center justify-center bg-[var(--ivory)] p-2\" data-kid=\"2-1-1-1\" data-name=\"cafe logo link\" href=\"#opening\">\n                <img alt=\"Logo Café Artesano\" class=\"h-auto w-[105px] mix-blend-multiply\" data-kid=\"2-1-1-1-1\" data-name=\"cafe logo image\" decoding=\"async\" fetchpriority=\"high\" loading=\"lazy\" onerror=\"this.classList.add('hidden');this.nextElementSibling.classList.remove('hidden');\" src=\"/api/local/images/.kombai/canvas/assets/cafe-artesano-logo.png\"/>\n                <span class=\"hidden font-yellowtail text-[22px] leading-none text-[var(--coffee)]\" data-kid=\"2-1-1-1-2\" data-name=\"cafe name text\">\n                    Café Artesano\n                </span>\n            </a>\n            <p class=\"font-yellowtail text-[28px] leading-none text-[var(--yellow)]\" data-kid=\"2-1-1-2\" data-name=\"daily hours label\">\n                Todos los días\n            </p>\n            <p class=\"mt-2 font-bowlby text-[54px] leading-[.88] tracking-[.02em] text-[var(--ivory)]\" data-kid=\"2-1-1-3\" data-name=\"daily hours range\">\n                8am—8pm\n            </p>\n            <div class=\"mt-16 border-t border-[var(--dark-line)] pt-7\" data-kid=\"2-1-1-4\" data-name=\"menu navigation container\">\n                <p class=\"mb-5 text-xs font-bold uppercase tracking-[.24em] text-[var(--beige)]\" data-kid=\"2-1-1-4-1\" data-name=\"menu section title\">\n                    Menú\n                </p>\n                <nav aria-label=\"Capítulos del menú\" class=\"relative space-y-1\" data-kid=\"2-1-1-4-2\" data-name=\"sidebar menu navigation links\" id=\"rail-nav\">\n                    <span aria-hidden=\"true\" class=\"rail-marker pointer-events-none absolute left-0 top-[20px] h-[3px] w-[18px] bg-[var(--yellow)]\" data-dynamic=\"true\" data-kid=\"2-1-1-4-2-1\" data-name=\"sidebar menu marker\" data-reason=\"top position updated by script on scroll\" id=\"rail-marker\">\n                    </span>\n                    <a aria-current=\"page\" class=\"rail-link flex min-h-11 items-center pl-7 text-lg font-bold text-[var(--ivory)]\" data-chapter-link=\"cortos\" data-kid=\"2-1-1-4-2-2\" data-name=\"cortos link\" href=\"#cortos\">\n                        Cortos\n                    </a>\n                    <a class=\"rail-link flex min-h-11 items-center pl-7 text-lg font-bold text-[var(--ivory)]\" data-chapter-link=\"con-leche\" data-kid=\"2-1-1-4-2-3\" data-name=\"con-leche link\" href=\"#con-leche\">\n                        Con leche\n                    </a>\n                    <a class=\"rail-link flex min-h-11 items-center pl-7 text-lg font-bold text-[var(--ivory)]\" data-chapter-link=\"sin-cafe\" data-kid=\"2-1-1-4-2-4\" data-name=\"sin-cafe link\" href=\"#sin-cafe\">\n                        Sin café\n                    </a>\n                    <a class=\"rail-link flex min-h-11 items-center pl-7 text-lg font-bold text-[var(--ivory)]\" data-chapter-link=\"para-comer\" data-kid=\"2-1-1-4-2-5\" data-name=\"para-comer link\" href=\"#para-comer\">\n                        Para comer\n                    </a>\n                </nav>\n            </div>\n        </div>\n        <address class=\"not-italic text-sm leading-6 text-[var(--beige)]\" data-kid=\"2-1-2\" data-name=\"footer contact address block\">\n      