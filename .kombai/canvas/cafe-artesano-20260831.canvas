ata-kid=\"2-4-1-1-2-1\" data-name=\"coffee icon\">\n                    </i>\n                    <span data-dynamic=\"true\" data-kid=\"2-4-1-1-2-2\" data-name=\"modal fallback title\" data-reason=\"text replaced by script\">\n                    </span>\n                </span>\n            </div>\n            <div class=\"ca-dialog-copy relative p-8 max-[599px]:p-5\" data-kid=\"2-4-1-2\" data-name=\"modal content\">\n                <button aria-label=\"Cerrar detalle del producto\" class=\"ca-close absolute right-5 top-5 bg-[var(--terracotta)] text-[11px] font-bold text-[var(--cream)] hover:bg-[var(--espresso)] focus-visible:outline-3 focus-visible:outline-[var(--yellow)] focus-visible:outline-offset-3\" data-kid=\"2-4-1-2-1\" data-name=\"close button\" id=\"dialog-close\" type=\"button\">\n                    Cerrar\n                </button>\n                <p class=\"pr-16 text-[11px] font-bold uppercase tracking-[.2em] text-[var(--logo-brown)]\" data-dynamic=\"true\" data-kid=\"2-4-1-2-2\" data-name=\"modal category\" data-reason=\"text replaced by script\" id=\"dialog-category\">\n                </p>\n                <div class=\"mt-7 flex items-start justify-between gap-4 border-b border-[var(--logo-brown)]/25 pb-5 max-[599px]:mt-6\" data-kid=\"2-4-1-2-3\" data-name=\"modal header container\">\n                    <h2 class=\"ca-rye max-w-[340px] text-[35px] leading-[1.03] text-[var(--espresso)] max-[599px]:text-[28px]\" data-dynamic=\"true\" data-kid=\"2-4-1-2-3-1\" data-name=\"modal title\" data-reason=\"text replaced by script\" id=\"dialog-title\">\n                    </h2>\n                    <span class=\"ca-price ca-tabular shrink-0 bg-[var(--yellow)] px-3 py-2 text-[18px] font-bold text-[var(--espresso)]\" data-dynamic=\"true\" data-kid=\"2-4-1-2-3-2\" data-name=\"modal price\" data-reason=\"text replaced by script\" id=\"dialog-price\">\n                    </span>\n                </div>\n                <p class=\"mt-5 text-[19px] leading-[1.25] text-[var(--ink)]\" data-dynamic=\"true\" data-kid=\"2-4-1-2-4\" data-name=\"modal summary\" data-reason=\"text replaced by script\" id=\"dialog-summary\">\n                </p>\n                <dl class=\"mt-7 space-y-4 text-[17px] leading-[1.25]\" data-kid=\"2-4-1-2-5\" data-name=\"modal details list\">\n                    <div data-kid=\"2-4-1-2-5-1\" data-name=\"ingredients list item\">\n                        <dt class=\"text-[11px] font-bold uppercase tracking-[.18em] text-[var(--logo-brown)]\" data-kid=\"2-4-1-2-5-1-1\" data-name=\"ingredients label\">\n                            Ingredientes\n                        </dt>\n                        <dd class=\"mt-1\" data-dynamic=\"true\" data-kid=\"2-4-1-2-5-1-2\" data-name=\"ingredients value\" data-reason=\"text replaced by script\" id=\"dialog-ingredients\">\n                        </dd>\n                    </div>\n                    <div data-kid=\"2-4-1-2-5-2\" data-name=\"preparation list item\">\n                        <dt class=\"text-[11px] font-bold uppercase tracking-[.18em] text-[var(--logo-brown)]\" data-kid=\"2-4-1-2-5-2-1\" data-name=\"preparation label\">\n                            Preparación\n                        </dt>\n                        <dd class=\"mt-1\" data-dynamic=\"true\" data-kid=\"2-4-1-2-5-2-2\" data-name=\"preparation value\" data-reason=\"text replaced by script\" id=\"dialog-preparation\">\n                        </dd>\n                    </div>\n                    <div data-kid=\"2-4-1-2-5-3\" data-name=\"taste list item\">\n                        <dt class=\"text-[11px] font-bold uppercase tracking-[.18em] text-[var(--logo-brown)]\" data-kid=\"2-4-1-2-5-3-1\" data-name=\"taste label\">\n                            Sabor y textura\n                        </dt>\n                        <dd class=\"mt-1\" data-dynamic=\"true\" data-kid=\"2-4-1-2-5-3-2\" data-name=\"taste value\" data-reason=\"text replaced by script\" id=\"dialog-taste\">\n                        </dd>\n                    </div>\n                </dl>\n            </div>\n        </div>\n    </div>\n</div>\n<script>\n    (() => {\n    const products = {\n      'Espresso': { category: 'Cafés', price: '$7.000', summary: 'Concentrado, aromático y con un final ligeramente caramelizado.', image: 'https://images.pexels.com/photos/30597790/pexels-photo-30597790.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Espresso en taza artesanal — Raymond Petrik on Pexels', ingredients: 'Café molido y agua caliente.', preparation: 'Extraído lentamente para conservar sus aromas.', taste: 'Cuerpo concentrado, aroma profundo y final ligeramente caramelizado.' },\n      'Americano': { category: 'Cafés', price: '$8.000', summary: 'Espresso alargado con agua caliente; intenso pero más ligero.', image: 'https://images.pexels.com/photos/28504480/pexels-photo-28504480.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Americano en taza sobre mesa de madera — Raymond Petrik on Pexels', ingredients: 'Espresso y agua caliente.', preparation: 'Servido al alargar el espresso con agua recién calentada.', taste: 'Aroma intenso, cuerpo más ligero y final limpio.' },\n      'Cappuccino': { category: 'Cafés', price: '$11.000', summary: 'Espresso, leche vaporizada y una capa generosa de espuma.', image: 'https://images.pexels.com/photos/30052601/pexels-photo-30052601.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Cappuccino con espuma natural — Alexander gomez on Pexels', ingredients: 'Espresso, leche vaporizada y espuma de leche.', preparation: 'La leche se vaporiza y se termina con una capa generosa de espuma.', taste: 'Equilibrado, cremoso y con una espuma suave.' },\n      'Latte': { category: 'Cafés', price: '$12.000', summary: 'Café suave con abundante leche vaporizada y espuma fina.', image: 'https://images.pexels.com/photos/34487852/pexels-photo-34487852.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Latte con espuma natural en taza — Dany Ortiz on Pexels', ingredients: 'Espresso, leche vaporizada y espuma fina.', preparation: 'Se combina el espresso con abundante leche vaporizada.', taste: 'Suave, sedoso y delicadamente espumoso.' },\n      'Mocha': { category: 'Cafés', price: '$13.000', summary: 'Espresso, chocolate y leche caliente en una mezcla cremosa.', image: 'https://images.pexels.com/photos/35289709/pexels-photo-35289709.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Mocha de chocolate en taza oscura — Sergio Arreola on Pexels', ingredients: 'Espresso, chocolate y leche caliente.', preparation: 'El chocolate se integra con el espresso antes de añadir la leche caliente.', taste: 'Cremoso, dulce y de aroma intenso a café y chocolate.' },\n      'Chocolate caliente': { category: 'Otras bebidas', price: '$11.000', summary: 'Chocolate y leche caliente con textura espesa y reconfortante.', image: 'https://images.pexels.com/photos/5377541/pexels-photo-5377541.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Chocolate caliente servido en taza — Nataliya Vaitkevich on Pexels', ingredients: 'Chocolate y leche caliente.', preparation: 'Se calientan juntos hasta lograr una mezcla uniforme.', taste: 'Espeso, reconfortante y con sabor redondo a chocolate.' },\n      'Té': { category: 'Otras bebidas', price: '$8.000', summary: 'Infusión aromática servida caliente.', image: 'https://images.pexels.com/photos/33074048/pexels-photo-33074048.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Té caliente en taza de cerámica — Iulian Sandu on Pexels', ingredients: 'Hojas de té y agua caliente.', preparation: 'Infusionado en agua caliente hasta liberar sus aromas.', taste: 'Ligero, aromático y cálido.' },\n      'Frappé': { category: 'Otras bebidas', price: '$15.000', summary: 'Café frío licuado con leche y hielo.', image: 'https://images.pexels.com/photos/37486068/pexels-photo-37486068.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Frappé de café frío sobre barra — azra melek on Pexels', ingredients: 'Café, leche y hielo.', preparation: 'Se licúa en frío hasta integrar la leche y el hielo.', taste: 'Frío, cremoso y refrescante.' },\n      'Croissant': { category: 'Para acompañar', price: '$8.000', summary: 'Hojaldre dorado, ligero y de sabor mantequilloso.', image: 'https://images.pexels.com/photos/37643626/pexels-photo-37643626.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Croissant dorado servido en plato — zeynep on Pexels', ingredients: 'Masa de hojaldre y mantequilla.', preparation: 'Horneado hasta que sus capas quedan doradas.', taste: 'Ligero, crujiente por fuera y mantequilloso.' },\n      'Torta': { category: 'Para acompañar', price: '$10.000', summary: 'Porción de torta de la casa, húmeda y suave.', image: 'https://images.pexels.com/photos/37719220/pexels-photo-37719220.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Porción de torta sobre plato — Nati on Pexels', ingredients: 'Masa de torta y cobertura de la casa.', preparation: 'Horneada y servida en una porción individual.', taste: 'Húmeda, suave y delicadamente dulce.' },\n      'Cheesecake': { category: 'Para acompañar', price: '$12.000', summary: 'Relleno cremoso sobre una base crujiente de galleta.', image: 'https://images.pexels.com/photos/33130816/pexels-photo-33130816.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Cheesecake de vainilla sobre plato — Iulian Sandu on Pexels', ingredients: 'Queso crema y base crujiente de galleta.', preparation: 'Se prepara sobre una base de galleta y se enfría hasta afirmar.', taste: 'Cremoso, fresco y con una base crujiente.' },\n      'Sándwich': { category: 'Para acompañar', price: '$16.000', summary: 'Pan tostado con jamón y queso fundido.', image: 'https://images.pexels.com/photos/30380526/pexels-photo-30380526.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Sándwich tostado servido en plato — Cemrecan Yurtman on Pexels', ingredients: 'Pan, jamón y queso.', preparation: 'Tostado hasta fundir el queso y dorar el pan.', taste: 'Crujiente, cálido y sabroso.' }\n    };\n\n    const dialog = document.getElementById('product-dialog');\n    const closeButton = document.getElementById('dialog-close');\n    const dialogImage = document.getElementById('dialog-image');\n    const dialogPhoto = document.querySelector('[data-dialog-photo]');\n    const dialogFallback = document.querySelector('[data-dialog-fallback]');\n    let lastTrigger = null;\n    let previousOverflow = '';\n\n    const setText = (id, value) => { document.getElementById(id).textContent = value; };\n\n    const showDialog = (name, trigger) => {\n      const product = products[name];\n      if (!product) return;\n      lastTrigger = trigger;\n      setText('dialog-category', product.category);\n      setText('dialog-title', name);\n      setText('dialog-price', product.price);\n      setText('dialog-summary', product.summary);\n      setText('dialog-ingredients', product.ingredients);\n      setText('dialog-preparation', product.preparation);\n      setText('dialog-taste', product.taste);\n      dialogImage.src = product.image;\n      dialogImage.alt = product.alt;\n      dialogImage.classList.remove('hidden');\n      dialogFallback.classList.add('hidden');\n      dialogFallback.querySelector('span').textContent = name;\n      dialogPhoto.classList.remove('ca-failed-image');\n      dialog.removeAttribute('hidden');\n      dialog.classList.add('flex');\n      previousOverflow = document.body.style.overflow;\n      document.body.style.overflow = 'hidden';\n      closeButton.focus();\n    };\n\n    const hideDialog = () => {\n      dialog.classList.remove('flex');\n      dialog.setAttribute('hidden', '');\n      document.body.style.overflow = previousOverflow;\n      if (lastTrigger) lastTrigger.focus();\n    };\n\n    document.querySelectorAll('[data-open-product]').forEach((button) => {\n      button.addEventListener('click', () => showDialog(button.dataset.openProduct, button));\n    });\n\n    document.querySelectorAll('[data-image-frame] img').forEach((image) => {\n      image.addEventListener('error', () => {\n        const frame = image.closest('[data-image-frame]');\n        frame.classList.add('ca-failed-image');\n        frame.querySelector('[data-fallback]').classList.remove('hidden');\n      });\n    });\n\n    dialogImage.addEventListener('error', () => {\n      dialogPhoto.classList.add('ca-failed-image');\n      dialogImage.classList.add('hidden');\n      dialogFallback.classList.remove('hidden');\n    });\n    closeButton.addEventListener('click', hideDialog);\n    dialog.addEventListener('click', (event) => { if (event.target === dialog) hideDialog(); });\n    document.addEventListener('keydown', (event) => {\n      if (dialog.hasAttribute('hidden')) return;\n      if (event.key === 'Escape') { event.preventDefault(); hideDialog(); return; }\n      if (event.key === 'Tab') {\n        const focusable = dialog.querySelectorAll('button, a[href], [tabindex]:not([tabindex=\"-1\"])');\n        if (!focusable.length) return;\n        const first = focusable[0];\n        const last = focusable[focusable.length - 1];\n        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }\n        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }\n      }\n    });\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-08-31T16:13:31.210983+00:00",
