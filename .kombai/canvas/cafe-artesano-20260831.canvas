b?auto=format&w=800&q=80&fit=crop\"/>\n                    </div>\n                    <div class=\"min-w-0 self-stretch\" data-kid=\"1-2-2-1-14-3\" data-name=\"product info block\">\n                        <h3 class=\"font-display text-[22px] leading-none sm:text-[24px] lg:text-[27px]\" data-kid=\"1-2-2-1-14-3-1\" data-name=\"product title\">\n                            Cheesecake\n                        </h3>\n                        <p class=\"summary-clamp mt-2 text-[12px] leading-[1.35] text-[var(--muted)] sm:text-[13px]\" data-kid=\"1-2-2-1-14-3-2\" data-name=\"product description summary\">\n                            Relleno cremoso sobre base crujiente.\n                        </p>\n                    </div>\n                    <div class=\"flex h-full min-w-0 flex-col items-end justify-between gap-3 text-right\" data-kid=\"1-2-2-1-14-4\" data-name=\"product price and action block\">\n                        <span class=\"font-cafe-mono whitespace-nowrap text-[11px] font-semibold sm:text-[12px] lg:text-[14px]\" data-kid=\"1-2-2-1-14-4-1\" data-name=\"product price\">\n                            $12.000\n                        </span>\n                        <button aria-controls=\"product-dialog\" aria-haspopup=\"dialog\" class=\"text-action focus-ring text-[11px] font-semibold sm:text-[12px]\" data-kid=\"1-2-2-1-14-4-2\" data-name=\"view more button\" data-product-open=\"\" type=\"button\">\n                            Ver más\n                        </button>\n                    </div>\n                </article>\n                <article class=\"catalog-row grid grid-cols-[24px_88px_minmax(0,1fr)_72px] items-center gap-3 border-b-2 border-[var(--coffee)] py-5 lg:grid-cols-[32px_112px_minmax(0,1fr)_94px] lg:gap-4\" data-alt=\"Sándwich tostado servido en mesa — Cemrecan Yurtman en Pexels\" data-detail=\"Pan tostado, jamón y queso en una combinación caliente y generosa. Crujiente por fuera, suave al centro.\" data-image=\"https://images.pexels.com/photos/30380526/pexels-photo-30380526.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\" data-index=\"12\" data-kid=\"1-2-2-1-15\" data-name=\"catalog row item\" data-price=\"$16.000\" data-summary=\"Pan tostado con jamón y queso.\" id=\"product-12\">\n                    <span class=\"row-index font-cafe-mono self-start pt-1 text-[12px] font-semibold text-[var(--coffee)] lg:text-[14px]\" data-kid=\"1-2-2-1-15-1\" data-name=\"product index\">\n                        12\n                    </span>\n                    <div class=\"relative h-[72px] w-[88px] overflow-hidden bg-[var(--surface)] lg:h-[84px] lg:w-[112px]\" data-kid=\"1-2-2-1-15-2\" data-name=\"product image container\">\n                        <img alt=\"Sándwich tostado servido en mesa — Cemrecan Yurtman en Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-2-2-1-15-2-1\" data-name=\"product thumbnail image\" decoding=\"async\" loading=\"lazy\" sizes=\"(min-width: 1024px) 112px, 88px\" src=\"https://images.pexels.com/photos/30380526/pexels-photo-30380526.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\"/>\n                    </div>\n                    <div class=\"min-w-0 self-stretch\" data-kid=\"1-2-2-1-15-3\" data-name=\"product info block\">\n                        <h3 class=\"font-display text-[22px] leading-none sm:text-[24px] lg:text-[27px]\" data-kid=\"1-2-2-1-15-3-1\" data-name=\"product title\">\n                            Sándwich\n                        </h3>\n                        <p class=\"summary-clamp mt-2 text-[12px] leading-[1.35] text-[var(--muted)] sm:text-[13px]\" data-kid=\"1-2-2-1-15-3-2\" data-name=\"product description summary\">\n                            Pan tostado con jamón y queso.\n                        </p>\n                    </div>\n                    <div class=\"flex h-full min-w-0 flex-col items-end justify-between gap-3 text-right\" data-kid=\"1-2-2-1-15-4\" data-name=\"product price and action block\">\n                        <span class=\"font-cafe-mono whitespace-nowrap text-[11px] font-semibold sm:text-[12px] lg:text-[14px]\" data-kid=\"1-2-2-1-15-4-1\" data-name=\"product price\">\n                            $16.000\n                        </span>\n                        <button aria-controls=\"product-dialog\" aria-haspopup=\"dialog\" class=\"text-action focus-ring text-[11px] font-semibold sm:text-[12px]\" data-kid=\"1-2-2-1-15-4-2\" data-name=\"view more button\" data-product-open=\"\" type=\"button\">\n                            Ver más\n                        </button>\n                    </div>\n                </article>\n            </div>\n            <aside aria-label=\"Vista previa del producto activo\" class=\"relative hidden min-w-0 lg:block\" data-kid=\"1-2-2-2\" data-name=\"sticky product preview aside\">\n                <div class=\"sticky top-6 mt-6 border-2 border-[var(--coffee)] bg-[var(--surface)] p-5\" data-kid=\"1-2-2-2-1\" data-name=\"sticky preview content frame\" id=\"sticky-preview\">\n                    <div class=\"flex items-center justify-between border-b-2 border-[var(--coffee)] pb-3\" data-kid=\"1-2-2-2-1-1\" data-name=\"preview header block\">\n                        <p class=\"text-[10px] font-semibold uppercase tracking-[0.19em] text-[var(--muted)]\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"preview label\">\n                            Vista previa\n                        </p>\n                        <span class=\"font-cafe-mono text-[10px] text-[var(--muted)]\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"preview ratio label\">\n                            4:5\n                        </span>\n                    </div>\n                    <div class=\"preview-frame relative mt-6 aspect-[4/5]\" data-kid=\"1-2-2-2-1-2\" data-name=\"preview image frame\">\n                        <span class=\"font-cafe-mono absolute -top-7 left-0 z-0 text-[116px] font-semibold leading-[0.8] tracking-[-0.1em] text-[var(--amber)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"preview product index\" data-reason=\"text updated based on active item by script\" id=\"preview-index\">\n                            01\n                        </span>\n                        <img alt=\"Espresso en taza de cerámica sobre piedra — Ramiro Pianarosa en Unsplash\" class=\"preview-image relative z-10 ml-10 block aspect-[4/5] w-[calc(100%-2.5rem)] object-cover bg-[var(--parchment)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"preview product image\" data-reason=\"image source/alt updated based on active item by script\" decoding=\"async\" id=\"preview-image\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1616786717075-bf6fd2ad6e10?auto=format&w=800&q=80&fit=crop\"/>\n                    </div>\n                    <div aria-live=\"polite\" class=\"mt-5 border-t-2 border-[var(--coffee)] pt-4\" data-kid=\"1-2-2-2-1-3\" data-name=\"preview details container\">\n                        <div class=\"flex items-end justify-between gap-4\" data-kid=\"1-2-2-2-1-3-1\" data-name=\"preview title and price block\">\n                            <h2 class=\"font-display min-w-0 text-[31px] leading-none text-[var(--ink)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-3-1-1\" data-name=\"preview product name\" data-reason=\"text updated based on active item by script\" id=\"preview-name\">\n                                Espresso\n                            </h2>\n                            <span class=\"font-cafe-mono shrink-0 text-[13px] font-semibold text-[var(--ink)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-3-1-2\" data-name=\"preview product price\" data-reason=\"text updated based on active item by script\" id=\"preview-price\">\n                                $7.000\n                            </span>\n                        </div>\n                        <p class=\"mt-3 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-2-2-1-3-2\" data-name=\"preview prompt text\">\n                            Selecciona Ver más para leer el detalle\n                        </p>\n                    </div>\n                </div>\n            </aside>\n        </section>\n        <section aria-labelledby=\"visit-title\" class=\"mt-24 border-y-2 border-[var(--coffee)] bg-[var(--terracotta)] px-6 py-12 text-[var(--cream)] sm:px-8 lg:py-14\" data-kid=\"1-2-3\" data-name=\"location contact section\" id=\"donde-estamos\">\n            <div class=\"grid gap-10 lg:grid-cols-[1.25fr_0.72fr_1fr] lg:gap-12\" data-kid=\"1-2-3-1\" data-name=\"location contact inner grid\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"location info block\">\n                    <p class=\"mb-4 text-[10px] font-semibold uppercase tracking-[0.25em] text-[var(--gold-light)]\" data-kid=\"1-2-3-1-1-1\" data-name=\"location label\">\n                        Visítanos\n                    </p>\n                    <h2 class=\"font-display text-[clamp(3rem,5vw,5rem)] leading-[0.86] tracking-[-0.04em]\" data-kid=\"1-2-3-1-1-2\" data-name=\"location headline\" id=\"visit-title\">\n                        Dónde\n                        <br class=\"hidden sm:block\" data-kid=\"1-2-3-1-1-2-1\"/>\n                        estamos\n                    </h2>\n                    <address class=\"mt-7 max-w-[380px] not-italic text-[19px] leading-[1.25] text-[var(--cream)]\" data-kid=\"1-2-3-1-1-3\" data-name=\"address text\">\n                        Calle 5 No. 13 - 177\n                    </address>\n                </div>\n                <div class=\"border-t border-[var(--line-light)] pt-6 lg:border-l lg:border-t-0 lg:pl-7 lg:pt-0\" data-kid=\"1-2-3-1-2\" data-name=\"hours info block\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.25em] text-[var(--gold-light)]\" data-kid=\"1-2-3-1-2-1\" data-name=\"hours label\">\n                        Horario\n                    </p>\n                    <p class=\"mt-6 text-[16px] leading-7 text-[var(--cream)]\" data-kid=\"1-2-3-1-2-2\" data-name=\"hours range text\">\n                        Todos los días\n                        <br data-kid=\"1-2-3-1-2-2-1\" data-name=\"hours range bold time\"/>\n                        <strong class=\"font-semibold\" data-kid=\"1-2-3-1-2-2-2\">\n                            8am–8pm\n                        </strong>\n                    </p>\n                </div>\n                <div class=\"border-t border-[var(--line-light)] pt-6 lg:border-l lg:border-t-0 lg:pl-7 lg:pt-0\" data-kid=\"1-2-3-1-3\" data-name=\"contact info block\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.25em] text-[var(--gold-light)]\" data-kid=\"1-2-3-1-3-1\" data-name=\"contact label\">\n                        Contacto\n                    </p>\n                    <a aria-label=\"Llamar al 320 565 7444\" class=\"focus-ring mt-6 block w-fit text-[15px] text-[var(--cream)] underline decoration-1 underline-offset-4\" data-kid=\"1-2-3-1-3-2\" data-name=\"contact phone link\" href=\"tel:3205657444\">\n                        320 565 7444\n                    </a>\n                    <a aria-label=\"Enviar correo a dianamejiaf97@gmail.com\" class=\"focus-ring mt-3 block w-fit max-w-full break-words text-[15px] text-[var(--cream)] underline decoration-1 underline-offset-4\" data-kid=\"1-2-3-1-3-3\" data-name=\"contact email link\" href=\"mailto:dianamejiaf97@gmail.com\">\n                        dianamejiaf97@gmail.com\n                    </a>\n                </div>\n            </div>\n        </section>\n        <footer class=\"flex flex-col gap-2 py-7 text-[11px] text-[var(--muted)] sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-2-4\" data-name=\"footer section\">\n            <p data-kid=\"1-2-4-1\" data-name=\"footer copyright text\">\n                Café Artesano · Calle 5 No. 13 - 177\n            </p>\n            <p class=\"font-cafe-mono text-[10px] tracking-[0.12em]\" data-kid=\"1-2-4-2\" data-name=\"footer signature text\">\n                MENÚ DE LA CASA · 01—12\n            </p>\n        </footer>\n    </main>\n    <div aria-describedby=\"dialog-detail\" aria-hidden=\"true\" aria-labelledby=\"dialog-name\" aria-modal=\"true\" class=\"fixed inset-0 z-50 hidden items-center justify-center bg-[var(--overlay)] p-4 sm:p-6\" data-dynamic=\"true\" data-kid=\"1-3\" data-name=\"product modal dialog\" data-reason=\"modal content and visibility updated dynamically by script\" id=\"product-dialog\" role=\"dialog\">\n        <div class=\"dialog-panel max-h-[86vh] w-full max-w-[780px] overflow-hidden border-2 border-[var(--coffee)] bg-[var(--surface)] sm:max-h-[620px]\" data-kid=\"1-3-1\" data-name=\"modal panel container\" tabindex=\"-1\">\n            <div class=\"max-h-[86vh] overflow-y-auto overscroll-contain p-5 sm:max-h-[620px] sm:p-7\" data-kid=\"1-3-1-1\" data-name=\"modal inner content wrapper\">\n                <header class=\"flex items-start justify-between gap-5 border-b-2 border-[var(--coffee)] pb-4\" data-kid=\"1-3-1-1-1\" data-name=\"modal header block\">\n                    <div class=\"min-w-0\" data-dynamic=\"true\" data-kid=\"1-3-1-1-1-1\" data-name=\"modal product index and label\" data-reason=\"text updated based on selected product by script\">\n                        <p class=\"font-cafe-mono text-[11px] font-semibold tracking-[0.08em] text-[var(--amber)]\" data-kid=\"1-3-1-1-1-1-1\" id=\"dialog-index\">\n                            01 · Detalle del producto\n                        </p>\n                        <h2 class=\"font-display mt-1 text-[35px] leading-none text-[var(--ink)]\" data-kid=\"1-3-1-1-1-1-2\" id=\"dialog-name\">\n                            Espresso\n                        </h2>\n                    </div>\n                    <button class=\"text-action focus-ring shrink-0 text-[12px] font-semibold\" data-dynamic=\"true\" data-kid=\"1-3-1-1-1-2\" data-name=\"modal product title\" data-reason=\"text updated based on selected product by script\" id=\"dialog-close\" type=\"button\">\n                        Cerrar\n                        <i aria-hidden=\"true\" class=\"ti ti-x ml-1 text-[15px]\" data-kid=\"1-3-1-1-1-2-1\">\n                        </i>\n                    </button>\n                </header>\n                <div class=\"mt-5 h-[200px] w-full overflow-hidden bg-[var(--parchment)] sm:aspect-video sm:h-auto\" data-kid=\"1-3-1-1-2\" data-name=\"modal image frame\" id=\"dialog-image-frame\">\n                    <img alt=\"Espresso en taza de cerámica sobre piedra — Ramiro Pianarosa en Unsplash\" class=\"h-full w-full object-cover\" data-dynamic=\"true\" data-kid=\"1-3-1-1-2-1\" data-name=\"modal image\" data-reason=\"image source/alt updated based on selected product by script\" decoding=\"async\" id=\"dialog-image\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1616786717075-bf6fd2ad6e10?auto=format&w=800&q=80&fit=crop\"/>\n                </div>\n                <div class=\"mt-5 flex items-end justify-between gap-5 border-b border-[var(--coffee)] pb-4\" data-kid=\"1-3-1-1-3\" data-name=\"modal price block\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.22em] text-[var(--muted)]\" data-kid=\"1-3-1-1-3-1\" data-name=\"modal preparation label\">\n                        Preparación y sabor\n                    </p>\n                    <strong class=\"font-cafe-mono shrink-0 text-[17px] font-semibold text-[var(--amber)]\" data-dynamic=\"true\" data-kid=\"1-3-1-1-3-2\" data-name=\"modal product price\" data-reason=\"text updated based on selected product by script\" id=\"dialog-price\">\n                        $7.000\n                    </strong>\n                </div>\n                <p class=\"mt-4 max-w-[660px] text-[15px] leading-7 text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-3-1-1-4\" data-name=\"modal product detail description\" data-reason=\"text updated based on selected product by script\" id=\"dialog-detail\">\n                    Una extracción corta preparada al momento, con aroma profundo, cuerpo redondo y un final limpio que deja hablar al grano.\n                </p>\n            </div>\n        </div>\n    </div>\n</div>\n<script>\n    (() => {\n    const page = document.querySelector('.cafe-page');\n    if (!page) return;\n\n    const rows = Array.from(page.querySelectorAll('.catalog-row'));\n    const previewImage = page.querySelector('#preview-image');\n    const previewIndex = page.querySelector('#preview-index');\n    const previewName = page.querySelector('#preview-name');\n    const previewPrice = page.querySelector('#preview-price');\n    const productDialog = page.querySelector('#product-dialog');\n    const dialogName = page.querySelector('#dialog-name');\n    const dialogIndex = page.querySelector('#dialog-index');\n    const dialogPrice = page.querySelector('#dialog-price');\n    const dialogImage = page.querySelector('#dialog-image');\n    const dialogDetail = page.querySelector('#dialog-detail');\n    const dialogClose = page.querySelector('#dialog-close');\n    let activeRow = rows[0] || null;\n    let previousTrigger = null;\n    let previousOverflow = '';\n    let previewTimer = null;\n    let dialogTimer = null;\n\n    const resetImage = (image) => {\n      if (!image || !image.parentElement) return;\n      image.classList.remove('hidden');\n      image.removeAttribute('data-error-rendered');\n      image.parentElement.querySelectorAll('[data-image-error]').forEach((item) => item.remove());\n      image.parentElement.classList.remove('flex', 'flex-col', 'items-center', 'justify-center', 'gap-2', 'text-center', 'text-[var(--muted)]');\n    };\n\n    const renderImageError = (image) => {\n      if (!image || !image.parentElement || image.dataset.errorRendered === 'true') return;\n      image.dataset.errorRendered = 'true';\n      image.classList.add('hidden');\n      const frame = image.parentElement;\n      frame.classList.add('flex', 'flex-col', 'items-center', 'justify-center', 'gap-2', 'text-center', 'text-[var(--muted)]');\n      const icon = document.createElement('i');\n      icon.className = 'ti ti-photo-off text-[20px]';\n      icon.setAttribute('aria-hidden', 'true');\n      icon.dataset.imageError = 'true';\n      const message = document.createElement('span');\n      message.className = 'text-[10px] leading-4';\n      message.textContent = 'Imagen no disponible';\n      message.dataset.imageError = 'true';\n      frame.append(icon, message);\n    };\n\n    const tryImageFallback = (image, fallbackImage, fallbackAlt) => {\n      if (!image || !fallbackImage || image.dataset.fallbackTried === 'true') return false;\n      image.dataset.fallbackTried = 'true';\n      image.src = fallbackImage;\n      if (fallbackAlt) image.alt = fallbackAlt;\n      return true;\n    };\n\n    const bindImageError = (image, fallbackGetter) => {\n      if (!image) return;\n      image.addEventListener('error', () => {\n        const fallback = fallbackGetter ? fallbackGetter() : null;\n        if (fallback && tryImageFallback(image, fallback.image, fallback.alt)) return;\n        renderImageError(image);\n      });\n    };\n\n    const readProduct = (row) => ({\n      index: row.dataset.index,\n      name: row.dataset.name,\n      price: row.dataset.price,\n      summary: row.dataset.summary,\n      detail: row.dataset.detail || row.dataset.summary,\n      image: row.dataset.image,\n      alt: row.dataset.alt\n    });\n\n    const markActive = (row) => {\n      if (!row || row === activeRow) return;\n      activeRow = row;\n      rows.forEach((item) => item.classList.toggle('is-active', item === row));\n      const product = readProduct(row);\n      resetImage(previewImage);\n      previewImage.removeAttribute('data-fallback-tried');\n      previewIndex.textContent = product.index;\n      previewName.textContent = product.name;\n      previewPrice.textContent = product.price;\n      window.clearTimeout(previewTimer);\n      const reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n      if (reduced) {\n        previewImage.src = product.image;\n        previewImage.alt = product.alt;\n        return;\n      }\n      previewImage.classList.add('is-fading');\n      previewTimer = window.setTimeout(() => {\n        previewImage.src = product.image;\n        previewImage.alt = product.alt;\n        previewImage.classList.remove('is-fading');\n      }, 130);\n    };\n\n    if (activeRow) activeRow.classList.add('is-active');\n\n    page.querySelectorAll('.catalog-row img').forEach((image) => {\n      bindImageError(image, () => {\n        const row = image.closest('.catalog-row');\n        return row && row.dataset.fallbackImage ? { image: row.dataset.fallbackImage, alt: row.dataset.fallbackAlt } : null;\n      });\n    });\n    bindImageError(previewImage, () => activeRow && activeRow.dataset.fallbackImage ? { image: activeRow.dataset.fallbackImage, alt: activeRow.dataset.fallbackAlt } : null);\n\n    const logo = page.querySelector('.cafe-logo');\n    const logoFallback = page.querySelector('.logo-fallback');\n    if (logo && logoFallback) {\n      logo.addEventListener('error', () => {\n        logo.classList.add('hidden');\n        logoFallback.classList.remove('hidden');\n      });\n    }\n\n    rows.forEach((row) => {\n      const action = row.querySelector('[data-product-open]');\n      if (action) {\n        action.addEventListener('focus', () => markActive(row));\n        action.addEventListener('click', () => openDialog(row, action));\n      }\n    });\n\n    if ('IntersectionObserver' in window) {\n      const visibleRows = new Set();\n      const chooseCenterRow = () => {\n        let closest = null;\n        let closestDistance = Infinity;\n        visibleRows.forEach((row) => {\n          const rect = row.getBoundingClientRect();\n          const distance = Math.abs((rect.top + rect.bottom) / 2 - window.innerHeight / 2);\n          if (distance < closestDistance) {\n            closestDistance = distance;\n            closest = row;\n          }\n        });\n        if (closest) markActive(closest);\n      };\n      const observer = new IntersectionObserver((entries) => {\n        entries.forEach((entry) => {\n          if (entry.isIntersecting) visibleRows.add(entry.target);\n          else visibleRows.delete(entry.target);\n        });\n        chooseCenterRow();\n      }, { root: null, rootMargin: '-42% 0px -42% 0px', threshold: 0.05 });\n      rows.forEach((row) => observer.observe(row));\n    }\n\n    function openDialog(row, trigger) {\n      const product = readProduct(row);\n      previousTrigger = trigger;\n      window.clearTimeout(dialogTimer);\n      dialogIndex.textContent = product.index + ' · Detalle del producto';\n      dialogName.textContent = product.name;\n      dialogPrice.textContent = product.price;\n      resetImage(dialogImage);\n      dialogImage.removeAttribute('data-fallback-tried');\n      dialogImage.dataset.fallbackImage = row.dataset.fallbackImage || '';\n      dialogImage.dataset.fallbackAlt = row.dataset.fallbackAlt || '';\n      dialogImage.src = product.image;\n      dialogImage.alt = product.alt;\n      dialogDetail.textContent = product.detail;\n      previousOverflow = document.body.style.overflow;\n      document.body.style.overflow = 'hidden';\n      productDialog.classList.remove('hidden');\n      productDialog.classList.add('flex');\n      productDialog.setAttribute('aria-hidden', 'false');\n      window.requestAnimationFrame(() => {\n        productDialog.classList.add('is-open');\n        dialogClose.focus();\n      });\n    }\n\n    function closeDialog() {\n      if (productDialog.classList.contains('hidden')) return;\n      productDialog.classList.remove('is-open');\n      const reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n      const delay = reduced ? 0 : 120;\n      window.clearTimeout(dialogTimer);\n      dialogTimer = window.setTimeout(() => {\n        productDialog.classList.add('hidden');\n        productDialog.classList.remove('flex');\n        productDialog.setAttribute('aria-hidden', 'true');\n        document.body.style.overflow = previousOverflow;\n        if (previousTrigger) previousTrigger.focus();\n      }, delay);\n    }\n\n    dialogImage.addEventListener('error', () => {\n      if (tryImageFallback(dialogImage, dialogImage.dataset.fallbackImage, dialogImage.dataset.fallbackAlt)) return;\n      renderImageError(dialogImage);\n    });\n\n    dialogClose.addEventListener('click', closeDialog);\n    productDialog.addEventListener('click', (event) => {\n      if (event.target === productDialog) closeDialog();\n    });\n\n    document.addEventListener('keydown', (event) => {\n      if (productDialog.classList.contains('hidden')) return;\n      if (event.key === 'Escape') {\n        event.preventDefault();\n        closeDialog();\n        return;\n      }\n      if (event.key !== 'Tab') return;\n      const focusable = Array.from(productDialog.querySelectorAll('button, [href], [tabindex]:not([tabindex=\"-1\"])')).filter((item) => !item.hasAttribute('disabled'));\n      if (!focusable.length) return;\n      const first = focusable[0];\n      const last = focusable[focusable.length - 1];\n      if (event.shiftKey && document.activeElement === first) {\n        event.preventDefault();\n        last.focus();\n      } else if (!event.shiftKey && document.activeElement === last) {\n        event.preventDefault();\n        first.focus();\n      }\n    });\n  })();\n</script>\n",
