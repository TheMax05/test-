i-arrow-up-right\" data-kid=\"2-2-8-2-2-3-2-3-1\" data-name=\"call icon\">\n                                </i>\n                            </a>\n                        </dd>\n                    </div>\n                    <div class=\"border-b border-[var(--dark-line)] py-5\" data-kid=\"2-2-8-2-2-4\" data-name=\"email section\">\n                        <dt class=\"text-xs font-bold uppercase tracking-[.22em] text-[var(--yellow)]\" data-kid=\"2-2-8-2-2-4-1\" data-name=\"email heading\">\n                            Correo\n                        </dt>\n                        <dd class=\"mt-2 flex flex-wrap items-center gap-x-3 gap-y-2 text-lg\" data-kid=\"2-2-8-2-2-4-2\" data-name=\"email wrapper\">\n                            <span data-kid=\"2-2-8-2-2-4-2-1\" data-name=\"email dash\">\n                                —\n                            </span>\n                            <a class=\"break-all underline decoration-[var(--yellow)] underline-offset-4\" data-kid=\"2-2-8-2-2-4-2-2\" data-name=\"email link\" href=\"mailto:dianamejiaf97@gmail.com\">\n                                dianamejiaf97@gmail.com\n                            </a>\n                            <a class=\"inline-flex min-h-11 items-center gap-2 font-bold underline decoration-[var(--orange)] underline-offset-4\" data-kid=\"2-2-8-2-2-4-2-3\" data-name=\"email action link\" href=\"mailto:dianamejiaf97@gmail.com\">\n                                Enviar correo\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"2-2-8-2-2-4-2-3-1\" data-name=\"email icon\">\n                                </i>\n                            </a>\n                        </dd>\n                    </div>\n                </dl>\n            </div>\n        </section>\n    </main>\n    <div aria-describedby=\"dialog-summary\" aria-hidden=\"true\" aria-labelledby=\"dialog-title\" aria-modal=\"true\" class=\"fixed inset-0 z-50 hidden items-center justify-center p-4\" data-dynamic=\"true\" data-kid=\"2-3\" data-name=\"product dialog overlay\" data-reason=\"content replaced by script on button click\" id=\"product-dialog\" role=\"dialog\">\n        <div aria-hidden=\"true\" class=\"dialog-backdrop absolute inset-0 bg-[var(--espresso)] opacity-0\" data-dialog-overlay=\"\" data-kid=\"2-3-1\" data-name=\"dialog backdrop\">\n        </div>\n        <section class=\"dialog-panel relative z-10 max-h-[calc(100vh-2rem)] w-full max-w-[820px] overflow-y-auto border-2 border-[var(--espresso)] bg-[var(--ivory)] text-[var(--espresso)]\" data-kid=\"2-3-2\" data-name=\"dialog panel\" tabindex=\"-1\">\n            <span aria-hidden=\"true\" class=\"pointer-events-none absolute right-0 top-0 z-20 h-28 w-48 bg-[var(--orange)]\" data-kid=\"2-3-2-1\" data-name=\"dialog decorative top corner shape\" style=\"clip-path: polygon(28% 0, 100% 0, 100% 100%, 0 0);\">\n            </span>\n            <button aria-label=\"Cerrar\" class=\"relative z-30 ml-auto grid h-11 w-11 place-items-center border-2 border-[var(--espresso)] bg-[var(--ivory)] text-xl\" data-dialog-close=\"\" data-kid=\"2-3-2-2\" data-name=\"close dialog button\" id=\"dialog-close-top\" title=\"Cerrar\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-x\" data-kid=\"2-3-2-2-1\" data-name=\"close icon\">\n                </i>\n            </button>\n            <div class=\"grid md:grid-cols-[1.05fr_.95fr]\" data-kid=\"2-3-2-3\" data-name=\"dialog content layout\">\n                <div class=\"relative aspect-[16/10] bg-[var(--yellow)] md:aspect-auto md:min-h-[480px]\" data-kid=\"2-3-2-3-1\" data-name=\"dialog image wrapper\">\n                    <img alt=\"Espresso on a geometric plate — Arturo Añez. on Pexels\" class=\"h-full w-full object-cover\" data-dynamic=\"true\" data-kid=\"2-3-2-3-1-1\" data-name=\"dialog image\" data-reason=\"image src and alt replaced by script\" decoding=\"async\" id=\"dialog-image\" loading=\"lazy\" src=\"https://images.pexels.com/photos/14315837/pexels-photo-14315837.jpeg?auto=compress&cs=tinysrgb&w=960&q=80\"/>\n                    <div class=\"absolute inset-0 hidden flex-col items-center justify-center gap-3 bg-[var(--yellow)] text-center font-bold\" data-kid=\"2-3-2-3-1-2\" data-name=\"dialog image fallback\" id=\"dialog-image-fallback\">\n                        <i aria-hidden=\"true\" class=\"ti ti-cup-hot text-4xl\" data-kid=\"2-3-2-3-1-2-1\" data-name=\"fallback icon\">\n                        </i>\n                        <span data-dynamic=\"true\" data-kid=\"2-3-2-3-1-2-2\" data-name=\"dialog fallback name\" data-reason=\"text content replaced by script\" id=\"dialog-fallback-name\">\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex flex-col justify-center p-7 pt-8 md:p-10\" data-kid=\"2-3-2-3-2\" data-name=\"dialog text content wrapper\">\n                    <p class=\"font-yellowtail text-3xl leading-none text-[var(--coffee)]\" data-dynamic=\"true\" data-kid=\"2-3-2-3-2-1\" data-name=\"dialog category text\" data-reason=\"text content replaced by script\" id=\"dialog-category\">\n                        Cortos\n                    </p>\n                    <h2 class=\"mt-3 font-bowlby text-4xl leading-none\" data-dynamic=\"true\" data-kid=\"2-3-2-3-2-2\" data-name=\"dialog title text\" data-reason=\"text content replaced by script\" id=\"dialog-title\">\n                        Espresso\n                    </h2>\n                    <p class=\"mt-6 text-2xl font-bold tabular-nums\" data-dynamic=\"true\" data-kid=\"2-3-2-3-2-3\" data-name=\"dialog price text\" data-reason=\"text content replaced by script\" id=\"dialog-price\">\n                        $7.000\n                    </p>\n                    <p class=\"mt-5 max-w-[300px] text-lg leading-7\" data-dynamic=\"true\" data-kid=\"2-3-2-3-2-4\" data-name=\"dialog description text\" data-reason=\"text content replaced by script\" id=\"dialog-summary\">\n                        Café concentrado de aroma profundo.\n                    </p>\n                    <button class=\"mt-9 inline-flex min-h-11 w-fit items-center border-b-2 border-[var(--orange)] font-bold\" data-dialog-close=\"\" data-kid=\"2-3-2-3-2-5\" data-name=\"dialog close button\" type=\"button\">\n                        Cerrar\n                    </button>\n                </div>\n            </div>\n        </section>\n    </div>\n</div>\n<script>\n    (function () {\n  const products = [\n    { name: 'Espresso', category: 'Cortos', price: '$7.000', summary: 'Café concentrado de aroma profundo.', image: 'https://images.pexels.com/photos/14315837/pexels-photo-14315837.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Espresso on a geometric plate — Arturo Añez. on Pexels' },\n    { name: 'Americano', category: 'Cortos', price: '$8.000', summary: 'Espresso suavizado con agua caliente.', image: 'https://images.pexels.com/photos/9490429/pexels-photo-9490429.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Americano coffee in a cup — DRAKE NICOLLS on Pexels' },\n    { name: 'Cappuccino', category: 'Con leche', price: '$11.000', summary: 'Espresso, leche vaporizada y espuma.', image: 'https://images.pexels.com/photos/34486654/pexels-photo-34486654.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Cappuccino in a cream cup — Esra Afşar on Pexels' },\n    { name: 'Latte', category: 'Con leche', price: '$12.000', summary: 'Café suave con abundante leche caliente.', image: 'https://images.pexels.com/photos/35054360/pexels-photo-35054360.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Latte in a cream cup — Esra Afşar on Pexels' },\n    { name: 'Mocha', category: 'Con leche', price: '$13.000', summary: 'Espresso y chocolate con textura cremosa.', image: 'https://images.unsplash.com/photo-1530629159325-9c378fc150b9?auto=format&w=720&q=80&fit=crop', alt: 'Mocha in a cup — Benjamin Sow on Unsplash' },\n    { name: 'Chocolate caliente', category: 'Sin café', price: '$11.000', summary: 'Chocolate caliente preparado con leche.', image: 'https://images.pexels.com/photos/19202823/pexels-photo-19202823.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Hot chocolate in a tall glass — Nano Erdozain on Pexels' },\n    { name: 'Té', category: 'Sin café', price: '$8.000', summary: 'Infusión aromática servida caliente.', image: 'https://images.pexels.com/photos/37119337/pexels-photo-37119337.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Hot tea in a glass cup — Efe Burak Baydar on Pexels' },\n    { name: 'Frappé', category: 'Sin café', price: '$15.000', summary: 'Café, leche y hielo licuados.', image: 'https://images.pexels.com/photos/37486068/pexels-photo-37486068.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Frappé drink on a café bar — azra melek on Pexels' },\n    { name: 'Croissant', category: 'Para comer', price: '$8.000', summary: 'Hojaldre ligero y mantequilloso.', image: 'https://images.unsplash.com/photo-1782380370752-28ee81b67974?auto=format&w=720&q=80&fit=crop', alt: 'Croissant on a vintage plate — nilufar nattaq on Unsplash' },\n    { name: 'Torta', category: 'Para comer', price: '$10.000', summary: 'Porción suave de la torta de la casa.', image: 'https://images.pexels.com/photos/37719220/pexels-photo-37719220.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Slice of cake on a white plate — Nati on Pexels' },\n    { name: 'Cheesecake', category: 'Para comer', price: '$12.000', summary: 'Relleno cremoso y base de galleta.', image: 'https://images.pexels.com/photos/33130816/pexels-photo-33130816.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Cheesecake slice on a plate — Iulian Sandu on Pexels' },\n    { name: 'Sándwich', category: 'Para comer', price: '$16.000', summary: 'Pan tostado, jamón y queso fundido.', image: 'https://images.pexels.com/photos/30380526/pexels-photo-30380526.jpeg?auto=compress&cs=tinysrgb&w=720&q=80', alt: 'Toasted sandwich on a plate — Cemrecan Yurtman on Pexels' }\n  ];\n\n  const dialog = document.getElementById('product-dialog');\n  const panel = dialog.querySelector('.dialog-panel');\n  const closeButtons = dialog.querySelectorAll('[data-dialog-close]');\n  const productButtons = document.querySelectorAll('[data-product-index]');\n  const dialogImage = document.getElementById('dialog-image');\n  const dialogImageFallback = document.getElementById('dialog-image-fallback');\n  const dialogFallbackName = document.getElementById('dialog-fallback-name');\n  const dialogCategory = document.getElementById('dialog-category');\n  const dialogTitle = document.getElementById('dialog-title');\n  const dialogPrice = document.getElementById('dialog-price');\n  const dialogSummary = document.getElementById('dialog-summary');\n  let lastFocusedElement = null;\n  let closeTimer = null;\n\n  function showProduct(index, trigger) {\n    const product = products[index];\n    if (!product) return;\n    lastFocusedElement = trigger || document.activeElement;\n    dialogCategory.textContent = product.category;\n    dialogTitle.textContent = product.name;\n    dialogPrice.textContent = product.price;\n    dialogSummary.textContent = product.summary;\n    dialogImageFallback.classList.add('hidden');\n    dialogFallbackName.textContent = product.name;\n    dialogImage.classList.remove('hidden');\n    dialogImage.alt = product.alt;\n    dialogImage.src = product.image.replace('w=720', 'w=960');\n    dialogImage.onerror = function () {\n      dialogImage.classList.add('hidden');\n      dialogImageFallback.classList.remove('hidden');\n    };\n    if (closeTimer) window.clearTimeout(closeTimer);\n    dialog.classList.remove('hidden');\n    dialog.setAttribute('aria-hidden', 'false');\n    document.body.classList.add('dialog-open');\n    window.requestAnimationFrame(function () {\n      dialog.classList.add('dialog-open');\n    });\n    window.setTimeout(function () { closeButtons[0].focus(); }, 20);\n  }\n\n  function hideProduct() {\n    if (dialog.classList.contains('hidden')) return;\n    dialog.classList.remove('dialog-open');\n    dialog.setAttribute('aria-hidden', 'true');\n    document.body.classList.remove('dialog-open');\n    closeTimer = window.setTimeout(function () {\n      dialog.classList.add('hidden');\n      if (lastFocusedElement && document.body.contains(lastFocusedElement)) lastFocusedElement.focus();\n    }, 160);\n  }\n\n  productButtons.forEach(function (button) {\n    button.addEventListener('click', function () {\n      showProduct(Number(button.dataset.productIndex), button);\n    });\n  });\n  closeButtons.forEach(function (button) { button.addEventListener('click', hideProduct); });\n  dialog.addEventListener('click', function (event) {\n    if (event.target === dialog || event.target.hasAttribute('data-dialog-overlay')) hideProduct();\n  });\n  panel.addEventListener('keydown', function (event) {\n    if (event.key === 'Escape') {\n      event.preventDefault();\n      hideProduct();\n      return;\n    }\n    if (event.key !== 'Tab') return;\n    const focusable = Array.from(panel.querySelectorAll('button, a, input, select, textarea, [tabindex]:not([tabindex=\"-1\"])')).filter(function (el) { return !el.disabled && el.offsetParent !== null; });\n    if (!focusable.length) return;\n    const first = focusable[0];\n    const last = focusable[focusable.length - 1];\n    if (event.shiftKey && document.activeElement === first) {\n      event.preventDefault();\n      last.focus();\n    } else if (!event.shiftKey && document.activeElement === last) {\n      event.preventDefault();\n      first.focus();\n    }\n  });\n\n  const chapterIds = ['cortos', 'con-leche', 'sin-cafe', 'para-comer'];\n  const railLinks = Array.from(document.querySelectorAll('[data-chapter-link]'));\n  const mobileLinks = Array.from(document.querySelectorAll('[data-mobile-link]'));\n  const railMarker = document.getElementById('rail-marker');\n\n  function syncChapter(id) {\n    railLinks.forEach(function (link) {\n      if (link.dataset.chapterLink === id) link.setAttribute('aria-current', 'page');\n      else link.removeAttribute('aria-current');\n    });\n    mobileLinks.forEach(function (link) {\n      if (link.dataset.mobileLink === id) link.setAttribute('aria-current', 'page');\n      else link.removeAttribute('aria-current');\n    });\n    const active = railLinks.find(function (link) { return link.dataset.chapterLink === id; });\n    if (active && window.innerWidth >= 1024) railMarker.style.top = (active.offsetTop + (active.offsetHeight / 2) - 1.5) + 'px';\n  }\n  railLinks.forEach(function (link) { link.addEventListener('click', function () { syncChapter(link.dataset.chapterLink); }); });\n  mobileLinks.forEach(function (link) { link.addEventListener('click', function () { syncChapter(link.dataset.mobileLink); }); });\n  if ('IntersectionObserver' in window) {\n    const observer = new IntersectionObserver(function (entries) {\n      const visible = entries.filter(function (entry) { return entry.isIntersecting; }).sort(function (a, b) { return b.intersectionRatio - a.intersectionRatio; });\n      if (visible[0]) syncChapter(visible[0].target.id);\n    }, { rootMargin: '-18% 0px -62% 0px', threshold: [0, .2, .5] });\n    chapterIds.forEach(function (id) { const section = document.getElementById(id); if (section) observer.observe(section); });\n  }\n  syncChapter('cortos');\n  window.addEventListener('resize', function () { syncChapter(document.querySelector('[data-mobile-link][aria-current=\"page\"]')?.dataset.mobileLink || 'cortos'); });\n})();\n</script>\n",
