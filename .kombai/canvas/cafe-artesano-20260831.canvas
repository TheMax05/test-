    "var_b49513bb5862": {
      "type": "variant",
      "label": "Café Artesano · Catálogo botánico",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Italianno&family=Spline+Sans+Mono:wght@400;500;600;700&family=Spline+Sans:wght@400;500;600;700&family=Unna:wght@700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .cafe-page {\n    --ink: #30241E;\n    --coffee: #684535;\n    --muted: #736A60;\n    --parchment: #E8D7B8;\n    --surface: #F8EEDB;\n    --amber: #D4A62A;\n    --terracotta: #B85B30;\n    --cream: #FFF4DE;\n    --gold-light: #F2C56D;\n    --line-light: rgba(255, 244, 222, 0.42);\n    --overlay: rgba(48, 36, 30, 0.76);\n    --font-body: 'Spline Sans', sans-serif;\n    --font-display: 'Unna', serif;\n    --font-script: 'Italianno', cursive;\n    --font-mono: 'Spline Sans Mono', monospace;\n    font-family: var(--font-body);\n    color: var(--ink);\n  }\n\n  .cafe-page .font-display { font-family: var(--font-display); }\n  .cafe-page .font-script { font-family: var(--font-script); }\n  .cafe-page .font-cafe-mono { font-family: var(--font-mono); }\n  .cafe-page .logo-fallback { font-family: var(--font-display); font-size: 14px; line-height: 0.9; color: var(--coffee); }\n\n  .cafe-page .summary-clamp {\n    display: -webkit-box;\n    overflow: hidden;\n    -webkit-box-orient: vertical;\n    -webkit-line-clamp: 2;\n  }\n\n  .cafe-page .text-action {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    border: 0;\n    background: transparent;\n    padding: 0;\n    color: var(--ink);\n    cursor: pointer;\n    text-decoration: none;\n  }\n\n  .cafe-page .text-action::after {\n    position: absolute;\n    right: 0;\n    bottom: -5px;\n    left: 0;\n    height: 2px;\n    background: var(--terracotta);\n    content: '';\n    transform: scaleX(0.4);\n    transform-origin: left center;\n    transition: transform 120ms ease;\n  }\n\n  .cafe-page .text-action:hover::after,\n  .cafe-page .text-action:focus-visible::after {\n    transform: scaleX(1);\n  }\n\n  .cafe-page .focus-ring:focus-visible {\n    outline: 3px solid var(--amber);\n    outline-offset: 3px;\n  }\n\n  .cafe-page .catalog-row.is-active .row-index {\n    color: var(--terracotta);\n  }\n\n  .cafe-page .preview-image {\n    transition: opacity 130ms ease;\n  }\n\n  .cafe-page .preview-image.is-fading {\n    opacity: 0.08;\n  }\n\n  .cafe-page #product-dialog {\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity 120ms ease;\n  }\n\n  .cafe-page #product-dialog.is-open {\n    opacity: 1;\n    pointer-events: auto;\n  }\n\n  .cafe-page .dialog-panel {\n    box-shadow: 12px 12px 0 var(--coffee);\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .cafe-page .text-action::after,\n    .cafe-page .preview-image,\n    .cafe-page #product-dialog {\n      transition-duration: 0ms;\n    }\n  }\n</style>\n<div class=\"cafe-page min-h-screen overflow-x-clip bg-[var(--parchment)] text-[var(--ink)] antialiased\" data-kid=\"1\" data-name=\"cafe website container\">\n    <header class=\"h-[84px] border-b-2 border-[var(--coffee)] px-5 lg:px-8 xl:px-10\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex h-full max-w-[1380px] items-center gap-5\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <div class=\"flex min-w-0 shrink-0 items-center gap-3 lg:gap-8\" data-kid=\"1-1-1-1\" data-name=\"logo and menu button group\">\n                <a aria-label=\"Ir al menú\" class=\"focus-ring block shrink-0\" data-kid=\"1-1-1-1-1\" data-name=\"logo link\" href=\"#menu\">\n                    <img alt=\"Café Artesano\" class=\"cafe-logo h-[58px] w-[100px] object-contain mix-blend-multiply\" data-kid=\"1-1-1-1-1-1\" data-name=\"cafe logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/cafe-artesano-logo.png\"/>\n                    <span aria-hidden=\"true\" class=\"logo-fallback hidden\" data-kid=\"1-1-1-1-1-2\" data-name=\"logo fallback text\">\n                        Café\n                        <br data-kid=\"1-1-1-1-1-2-1\"/>\n                        Artesano\n                    </span>\n                </a>\n                <a class=\"focus-ring shrink-0 text-[11px] font-semibold uppercase tracking-[0.2em] text-[var(--coffee)]\" data-kid=\"1-1-1-1-2\" data-name=\"menu link\" href=\"#menu\">\n                    Menú\n                </a>\n            </div>\n            <div class=\"hidden min-w-0 flex-1 items-center justify-center gap-10 lg:flex\" data-kid=\"1-1-1-2\" data-name=\"header info group\">\n                <p class=\"truncate text-[13px] text-[var(--muted)]\" data-kid=\"1-1-1-2-1\" data-name=\"header address text\">\n                    Calle 5 No. 13 - 177\n                </p>\n                <p class=\"shrink-0 text-[13px] text-[var(--muted)]\" data-kid=\"1-1-1-2-2\" data-name=\"header schedule text\">\n                    Todos los días · 8am–8pm\n                </p>\n            </div>\n            <div class=\"ml-auto hidden shrink-0 items-center gap-5 text-[12px] lg:flex\" data-kid=\"1-1-1-3\" data-name=\"contact link group\">\n                <a class=\"focus-ring underline decoration-1 underline-offset-4\" data-kid=\"1-1-1-3-1\" data-name=\"phone number link\" href=\"tel:3205657444\">\n                    320 565 7444\n                </a>\n                <a class=\"focus-ring underline decoration-1 underline-offset-4\" data-kid=\"1-1-1-3-2\" data-name=\"email link\" href=\"mailto:dianamejiaf97@gmail.com\">\n                    dianamejiaf97@gmail.com\n                </a>\n            </div>\n            <p class=\"ml-auto max-w-[118px] text-right text-[10px] leading-[1.25] text-[var(--muted)] lg:hidden\" data-kid=\"1-1-1-4\" data-name=\"mobile schedule text\">\n                Todos los días · 8am–8pm\n            </p>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1380px] px-5 lg:px-8 xl:px-10\" data-kid=\"1-2\" data-name=\"main content container\">\n        <section aria-labelledby=\"page-title\" class=\"grid gap-8 border-b-2 border-[var(--coffee)] py-12 lg:grid-cols-[minmax(0,1fr)_220px] lg:items-end lg:gap-16 lg:py-14\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div data-kid=\"1-2-1-1\" data-name=\"hero text content block\">\n                <p class=\"mb-4 text-[10px] font-semibold uppercase tracking-[0.28em] text-[var(--terracotta)]\" data-kid=\"1-2-1-1-1\" data-name=\"category label\">\n                    Café Artesano · catálogo\n                </p>\n                <h1 class=\"font-display text-[clamp(3.5rem,7vw,6.5rem)] leading-[0.84] tracking-[-0.055em] text-[var(--ink)]\" data-kid=\"1-2-1-1-2\" data-name=\"page main headline\" id=\"page-title\">\n                    Menú de la casa\n                </h1>\n                <p class=\"font-script mt-5 text-[35px] leading-[0.95] text-[var(--coffee)] sm:text-[39px]\" data-kid=\"1-2-1-1-3\" data-name=\"hero subheadline\">\n                    Doce preparaciones para cualquier momento del día\n                </p>\n            </div>\n            <div class=\"hidden border-l-2 border-[var(--coffee)] pb-1 pl-5 lg:block\" data-kid=\"1-2-1-2\" data-name=\"hero sidebar info block\">\n                <p class=\"font-cafe-mono text-[12px] font-semibold tracking-[0.16em] text-[var(--amber)]\" data-kid=\"1-2-1-2-1\" data-name=\"item count range label\">\n                    01—12\n                </p>\n                <p class=\"mt-3 max-w-[160px] text-[13px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-1-2-2\" data-name=\"hero description text\">\n                    Bebidas, panadería y café para elegir sin prisa.\n                </p>\n            </div>\n        </section>\n        <section aria-label=\"Menú de productos\" class=\"grid items-start lg:grid-cols-[minmax(0,58fr)_minmax(0,42fr)] lg:gap-10 xl:gap-14\" data-kid=\"1-2-2\" data-name=\"menu section\" id=\"menu\">\n            <div class=\"min-w-0\" data-kid=\"1-2-2-1\" data-name=\"menu items list container\">\n                <div class=\"flex items-baseline gap-4 border-b-2 border-[var(--coffee)] pb-3 pt-7\" data-kid=\"1-2-2-1-1\" data-name=\"category header block\">\n                    <span class=\"font-cafe-mono text-[11px] font-semibold tracking-[0.18em] text-[var(--amber)]\" data-kid=\"1-2-2-1-1-1\" data-name=\"category range label\">\n                        01—05\n                    </span>\n                    <h2 class=\"font-display text-[29px] leading-none text-[var(--coffee)]\" data-kid=\"1-2-2-1-1-2\" data-name=\"category title\">\n                        Cafés\n                    </h2>\n                </div>\n                <article class=\"catalog-row grid grid-cols-[24px_88px_minmax(0,1fr)_72px] items-center gap-3 border-b-2 border-[var(--coffee)] py-5 lg:grid-cols-[32px_112px_minmax(0,1fr)_94px] lg:gap-4\" data-alt=\"Espresso en taza de cerámica sobre piedra — Ramiro Pianarosa en Unsplash\" data-detail=\"Una extracción corta preparada al momento, con aroma profundo, cuerpo redondo y un final limpio que deja hablar al grano.\" data-image=\"https://images.unsplash.com/photo-1616786717075-bf6fd2ad6e10?auto=format&w=800&q=80&fit=crop\" data-index=\"01\" data-kid=\"1-2-2-1-2\" data-name=\"catalog row item\" data-price=\"$7.000\" data-summary=\"Extracción corta, intensa y aromática.\" id=\"product-01\">\n                    <span class=\"row-index font-cafe-mono self-start pt-1 text-[12px] font-semibold text-[var(--coffee)] lg:text-[14px]\" data-kid=\"1-2-2-1-2-1\" data-name=\"product index\">\n                        01\n                    </span>\n                    <div class=\"relative h-[72px] w-[88px] overflow-hidden bg-[var(--surface)] lg:h-[84px] lg:w-[112px]\" data-kid=\"1-2-2-1-2-2\" data-name=\"product image container\">\n                        <img alt=\"Espresso en taza de cerámica sobre piedra — Ramiro Pianarosa en Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"product thumbnail image\" decoding=\"async\" loading=\"lazy\" sizes=\"(min-width: 1024px) 112px, 88px\" src=\"https://images.unsplash.com/photo-1616786717075-bf6fd2ad6e10?auto=format&w=800&q=80&fit=crop\"/>\n                    </div>\n                    <div class=\"min-w-0 self-stretch\" data-kid=\"1-2-2-1-2-3\" data-name=\"product info block\">\n                        <h3 class=\"font-display text-[22px] leading-none sm:text-[24px] lg:text-[27px]\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"product title\">\n                            Espresso\n                        </h3>\n                        <p class=\"summary-clamp mt-2 text-[12px] leading-[1.35] text-[var(--muted)] sm:text-[13px]\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"product description summary\">\n                            Extracción corta, intensa y aromática.\n                        </p>\n                    </div>\n                    <div class=\"flex h-full min-w-0 flex-col items-end justify-between gap-3 text-right\" data-kid=\"1-2-2-1-2-4\" data-name=\"product price and action block\">\n                        <span class=\"font-cafe-mono whitespace-nowrap text-[11px] font-semibold sm:text-[12px] lg:text-[14px]\" data-kid=\"1-2-2-1-2-4-1\" data-name=\"product price\">\n                            $7.000\n                        </span>\n                        <button aria-controls=\"product-dialog\" aria-haspopup=\"dialog\" class=\"text-action focus-ring text-[11px] font-semibold sm:text-[12px]\" data-kid=\"1-2-2-1-2-4-2\" data-name=\"view more button\" data-product-open=\"\" type=\"button\">\n                            Ver más\n                        </button>\n                    </div>\n                </article>\n                <article class=\"catalog-row grid grid-cols-[24px_88px_minmax(0,1fr)_72px] items-center gap-3 border-b-2 border-[var(--coffee)] py-5 lg:grid-cols-[32px_112px_minmax(0,1fr)_94px] lg:gap-4\" data-alt=\"Americano servido en taza clara — Gül Işık en Pexels\" data-detail=\"Doble contacto de espresso y agua caliente: una taza más larga, ligera y aromática, pensada para beber despacio.\" data-image=\"https://images.pexels.com/photos/17612438/pexels-photo-17612438.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\" data-index=\"02\" data-kid=\"1-2-2-1-3\" data-name=\"catalog row item\" data-price=\"$8.000\" data-summary=\"Espresso con agua caliente y cuerpo ligero.\" id=\"product-02\">\n                    <span class=\"row-index font-cafe-mono self-start pt-1 text-[12px] font-semibold text-[var(--coffee)] lg:text-[14px]\" data-kid=\"1-2-2-1-3-1\" data-name=\"product index\">\n                        02\n                    </span>\n                    <div class=\"relative h-[72px] w-[88px] overflow-hidden bg-[var(--surface)] lg:h-[84px] lg:w-[112px]\" data-kid=\"1-2-2-1-3-2\" data-name=\"product image container\">\n                        <img alt=\"Americano servido en taza clara — Gül Işık en Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-2-2-1-3-2-1\" data-name=\"product thumbnail image\" decoding=\"async\" loading=\"lazy\" sizes=\"(min-width: 1024px) 112px, 88px\" src=\"https://images.pexels.com/photos/17612438/pexels-photo-17612438.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\"/>\n                    </div>\n                    <div class=\"min-w-0 self-stretch\" data-kid=\"1-2-2-1-3-3\" data-name=\"product info block\">\n                        <h3 class=\"font-display text-[22px] leading-none sm:text-[24px] lg:text-[27px]\" data-kid=\"1-2-2-1-3-3-1\" data-name=\"product title\">\n                            Americano\n                        </h3>\n                        <p class=\"summary-clamp mt-2 text-[12px] leading-[1.35] text-[var(--muted)] sm:text-[13px]\" data-kid=\"1-2-2-1-3-3-2\" data-name=\"product description summary\">\n                            Espresso con agua caliente y cuerpo ligero.\n                        </p>\n                    </div>\n                    <div class=\"flex h-full min-w-0 flex-col items-end justify-between gap-3 text-right\" data-kid=\"1-2-2-1-3-4\" data-name=\"product price and action block\">\n                        <span class=\"font-cafe-mono whitespace-nowrap text-[11px] font-semibold sm:text-[12px] lg:text-[14px]\" data-kid=\"1-2-2-1-3-4-1\" data-name=\"product price\">\n                            $8.000\n                        </span>\n                        <button aria-controls=\"product-dialog\" aria-haspopup=\"dialog\" class=\"text-action focus-ring text-[11px] font-semibold sm:text-[12px]\" data-kid=\"1-2-2-1-3-4-2\" data-name=\"view more button\" data-product-open=\"\" type=\"button\">\n                            Ver más\n                        </button>\n                    </div>\n                </article>\n                <article class=\"catalog-row grid grid-cols-[24px_88px_minmax(0,1fr)_72px] items-center gap-3 border-b-2 border-[var(--coffee)] py-5 lg:grid-cols-[32px_112px_minmax(0,1fr)_94px] lg:gap-4\" data-alt=\"Cappuccino con espuma sobre lino natural — Justus Menke en Unsplash\" data-detail=\"Espresso cubierto con leche vaporizada y una espuma abundante. Cremoso, equilibrado y cálido en cada sorbo.\" data-image=\"https://images.unsplash.com/photo-1602320574582-741740d4fcd7?auto=format&w=800&q=80&fit=crop\" data-index=\"03\" data-kid=\"1-2-2-1-4\" data-name=\"catalog row item\" data-price=\"$11.000\" data-summary=\"Espresso, leche vaporizada y espuma abundante.\" id=\"product-03\">\n                    <span class=\"row-index font-cafe-mono self-start pt-1 text-[12px] font-semibold text-[var(--coffee)] lg:text-[14px]\" data-kid=\"1-2-2-1-4-1\" data-name=\"product index\">\n                        03\n                    </span>\n                    <div class=\"relative h-[72px] w-[88px] overflow-hidden bg-[var(--surface)] lg:h-[84px] lg:w-[112px]\" data-kid=\"1-2-2-1-4-2\" data-name=\"product image container\">\n                        <img alt=\"Cappuccino con espuma sobre lino natural — Justus Menke en Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"1-2-2-1-4-2-1\" data-name=\"product thumbnail image\" decoding=\"async\" loading=\"lazy\" sizes=\"(min-width: 1024px) 112px, 88px\" src=\"https://images.unsplash.com/photo-1602320574582-741740d4fcd7?auto=format&w=800&q=80&fit=crop\"/>\n                    </div>\n                    <div class=\"min-w-0 self-stretch\" data-kid=\"1-2-2-1-4-3\" data-name=\"product info block\">\n                        <h3 class=\"font-display text-[22px] leading-none sm:text-[24px] lg:text-[27px]\" data-kid=\"1-2-2-1-4-3-1\" data-name=\"product title\">\n                            Cappuccino\n                        </h3>\n                        <p class=\"summary-clamp mt-2 text-[12px] leading-[1.35] text-[var(--muted)] sm:text-[13px]\" data-kid=\"1-2-2-1-4-3-2\" data-name=\"product description summary\">\n                            Espresso, leche vaporizada y espuma abundante.\n                        </p>\n                    </div>\n                    <div class=\"flex h-full min-w-0 flex-col items-end justify-between gap-3 text-right\" data-kid=\"1-2-2-1-4-4\" data-name=\"product price and action block\">\n                        <span class=\"font-cafe-mono whitespace-nowrap text-[11px] font-semibold sm:text-[12px] lg:text-[14px]\" data-kid=\"1-2-2-1-4-4-1\" data-name=\"product price\">\n                            $11.000\n                        </span>\n                        <button aria-controls=\"product-dialog\" aria-haspopup=\"dialog\" class=\"text-action focus-ring text-[11px] font-semibold sm:text-[12px]\" data-kid=\"1-2-2-1-4-4-2\" data-name=\"view more button\" data-product-open=\"\" type=\"button\">\n                            Ver más\n                        </button>\n                    </div>\n                </article>\n                <article class=\"catalog-row grid grid-cols-[24px_88px_minmax(0,1fr)_72px] items-center gap-3 border-b-2 border-[var(--coffee)] py-5 lg:grid-cols-[32px_112px_minmax(0,1fr)_94px] lg:gap-4\