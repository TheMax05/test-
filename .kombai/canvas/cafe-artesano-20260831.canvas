      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@400;500;600;700;800&family=Italianno&family=Rye&display=swap');\n\n  :root {\n    --espresso: #482419;\n    --logo-brown: #753721;\n    --terracotta: #D8783F;\n    --yellow: #F2C14E;\n    --paper: #F1DFC0;\n    --cream: #FFF7E8;\n    --ink: #2D1A14;\n    --muted-paper: #D7BA8B;\n  }\n\n  .ca-site {\n    min-height: 100%;\n    background: var(--paper);\n    color: var(--ink);\n    font-family: 'Alegreya Sans', sans-serif;\n  }\n\n  .ca-rye { font-family: 'Rye', serif; }\n  .ca-ital { font-family: 'Italianno', cursive; }\n  .ca-tabular { font-variant-numeric: tabular-nums; }\n  .ca-arch { border-radius: 52% 52% 0 0 / 24% 24% 0 0; }\n  .ca-photo-frame { background: var(--muted-paper); aspect-ratio: 4 / 3; overflow: hidden; }\n  .ca-photo-frame img { display: block; width: 100%; height: 100%; object-fit: cover; }\n  .ca-product-tile { background: var(--cream); }\n  .ca-product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px 16px; }\n  @media (min-width: 1120px) {\n    .ca-product-grid > .ca-product-tile { transform: none; }\n    .ca-product-grid > .ca-product-tile:nth-child(even) { transform: translateY(18px); }\n  }\n  .ca-summary { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }\n  .ca-price { clip-path: polygon(0 0, 100% 0, 100% 100%, 13px 100%, 0 calc(100% - 13px)); }\n  .ca-category-rule { display: flex; align-items: center; gap: 13px; }\n  .ca-category-rule::after { content: ''; height: 1px; flex: 1; background: var(--logo-brown); opacity: .58; }\n  .ca-rosette { position: relative; display: inline-block; width: 31px; height: 31px; color: var(--logo-brown); flex: 0 0 auto; }\n  .ca-rosette span { position: absolute; left: 10px; top: 6px; width: 11px; height: 18px; border: 1.7px solid currentColor; border-radius: 75% 30% 75% 30%; transform-origin: 50% 50%; }\n  .ca-rosette span:nth-child(1) { transform: rotate(0deg); }\n  .ca-rosette span:nth-child(2) { transform: rotate(90deg); }\n  .ca-rosette span:nth-child(3) { transform: rotate(180deg); }\n  .ca-rosette span:nth-child(4) { transform: rotate(270deg); }\n  .ca-rosette::after { content: ''; position: absolute; left: 13px; top: 13px; width: 5px; height: 5px; background: currentColor; border-radius: 50%; }\n  .ca-failed-image { display: flex !important; align-items: center; justify-content: center; background: var(--yellow); color: var(--espresso); }\n  .ca-failed-image img { display: none; }\n  .ca-mobile-menu summary { list-style: none; cursor: pointer; }\n  .ca-mobile-menu summary::-webkit-details-marker { display: none; }\n  .ca-dialog[hidden] { display: none; }\n  .ca-dialog { background: rgba(45, 26, 20, .70); }\n  .ca-dialog-panel { display: grid; grid-template-columns: 44% 56%; width: min(900px, 100%); max-height: 560px; min-height: 420px; background: var(--cream); box-shadow: 12px 16px 0 rgba(72, 36, 25, .28); }\n  .ca-dialog-photo { min-height: 100%; background: var(--muted-paper); overflow: hidden; }\n  .ca-dialog-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }\n  .ca-dialog-copy { overflow-y: auto; }\n  .ca-dialog-copy::-webkit-scrollbar { width: 8px; }\n  .ca-dialog-copy::-webkit-scrollbar-thumb { background: rgba(117, 55, 33, .42); }\n  .ca-close { width: 48px; height: 48px; }\n  .ca-action-arrow { display: inline-block; transition: transform 160ms ease; }\n  .ca-action:hover .ca-action-arrow { transform: translateX(3px); }\n\n  @media (max-width: 1119px) {\n    .ca-product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  }\n  @media (max-width: 899px) {\n    .ca-product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  }\n  @media (max-width: 599px) {\n    .ca-product-grid { grid-template-columns: 1fr; gap: 10px; }\n    .ca-product-tile { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 13px; padding: 10px; }\n    .ca-product-tile .ca-photo-frame { aspect-ratio: auto; height: 112px; }\n    .ca-product-tile .ca-card-copy { min-width: 0; padding: 1px 0 0; }\n    .ca-product-tile .ca-summary { font-size: 15px; line-height: 1.14; }\n    .ca-product-tile .ca-card-actions { margin-top: 9px; }\n    .ca-dialog-panel { grid-template-columns: 1fr; width: 92vw; max-height: 86vh; min-height: 0; }\n    .ca-dialog-photo { height: 225px; min-height: 0; }\n    .ca-dialog-copy { max-height: calc(86vh - 225px); }\n  }\n</style>\n<link data-kid=\"1\" data-name=\"google fonts stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"ca-site overflow-x-clip\" data-kid=\"2\" data-name=\"site container\">\n    <header class=\"border-b border-[var(--logo-brown)]/25 bg-[var(--paper)]\" data-kid=\"2-1\" data-name=\"header bar\">\n        <div class=\"mx-auto flex h-[68px] max-w-[1320px] items-center justify-between px-8 min-[1200px]:px-11 max-[599px]:h-14 max-[599px]:px-5\" data-kid=\"2-1-1\" data-name=\"header content wrapper\">\n            <div class=\"flex min-w-0 items-center gap-5 max-[599px]:gap-3\" data-kid=\"2-1-1-1\" data-name=\"logo and schedule container\">\n                <a aria-label=\"Café Artesano, ir al menú\" class=\"block shrink-0\" data-kid=\"2-1-1-1-1\" data-name=\"logo link\" href=\"#menu\">\n                    <object aria-label=\"Café Artesano\" class=\"h-12 w-[108px] object-contain mix-blend-multiply max-[599px]:h-10 max-[599px]:w-[92px]\" data=\"/api/local/images/.kombai/canvas/assets/cafe-artesano-logo.png\" data-kid=\"2-1-1-1-1-1\" data-name=\"logo image\" role=\"img\" type=\"image/png\">\n                        <span class=\"ca-rye text-[13px] text-[var(--logo-brown)]\" data-kid=\"2-1-1-1-1-1-1\" data-name=\"logo fallback text\">\n                            Café Artesano\n                        </span>\n                    </object>\n                </a>\n                <span class=\"text-[16px] font-semibold tracking-wide text-[var(--logo-brown)] max-[599px]:hidden\" data-kid=\"2-1-1-1-2\" data-name=\"store hours text\">\n                    Todos los días · 8am–8pm\n                </span>\n            </div>\n            <nav aria-label=\"Navegación principal\" class=\"flex items-center gap-8 text-[17px] font-semibold text-[var(--espresso)] max-[599px]:hidden\" data-kid=\"2-1-1-2\" data-name=\"desktop navigation menu\">\n                <a class=\"underline decoration-[var(--terracotta)] decoration-1 underline-offset-4 hover:text-[var(--terracotta)] focus-visible:outline-3 focus-visible:outline-[var(--yellow)] focus-visible:outline-offset-3\" data-kid=\"2-1-1-2-1\" data-name=\"menu navigation link\" href=\"#menu\">\n                    Menú\n                </a>\n                <a class=\"underline decoration-[var(--terracotta)] decoration-1 underline-offset-4 hover:text-[var(--terracotta)] focus-visible:outline-3 focus-visible:outline-[var(--yellow)] focus-visible:outline-offset-3\" data-kid=\"2-1-1-2-2\" data-name=\"visit navigation link\" href=\"#visit\">\n                    Visítanos\n                </a>\n                <a class=\"underline decoration-[var(--terracotta)] decoration-1 underline-offset-4 hover:text-[var(--terracotta)] focus-visible:outline-3 focus-visible:outline-[var(--yellow)] focus-visible:outline-offset-3\" data-kid=\"2-1-1-2-3\" data-name=\"contact navigation link\" href=\"#contacto\">\n                    Contacto\n                </a>\n            </nav>\n            <details class=\"ca-mobile-menu relative hidden max-[599px]:block\" data-kid=\"2-1-1-3\" data-name=\"mobile menu details\">\n                <summary class=\"border-b border-[var(--terracotta)] px-1 pb-0.5 text-[16px] font-bold text-[var(--espresso)] focus-visible:outline-3 focus-visible:outline-[var(--yellow)] focus-visible:outline-offset-3\" data-kid=\"2-1-1-3-1\" data-name=\"mobile menu trigger\">\n                    Menú\n                </summary>\n                <div class=\"absolute right-0 top-9 z-20 min-w-[142px] border border-[var(--logo-brown)]/30 bg-[var(--cream)] p-3 text-right text-[16px] font-semibold shadow-[5px_6px_0_rgba(72,36,25,.14)]\" data-kid=\"2-1-1-3-2\" data-name=\"mobile menu dropdown\">\n                    <a class=\"block py-1 underline decoration-[var(--terracotta)] underline-offset-4\" data-kid=\"2-1-1-3-2-1\" data-name=\"mobile menu link\" href=\"#menu\">\n                        Menú\n                    </a>\n                    <a class=\"block py-1 underline decoration-[var(--terracotta)] underline-offset-4\" data-kid=\"2-1-1-3-2-2\" data-name=\"mobile menu link\" href=\"#visit\">\n                        Visítanos\n                    </a>\n                    <a class=\"block py-1 underline decoration-[var(--terracotta)] underline-offset-4\" data-kid=\"2-1-1-3-2-3\" data-name=\"mobile menu link\" href=\"#contacto\">\n                        Contacto\n                    </a>\n                </div>\n            </details>\n        </div>\n    </header>\n    <main data-kid=\"2-2\" data-name=\"main content area\" id=\"menu\">\n        <section aria-labelledby=\"page-title\" class=\"mx-auto max-w-[1320px] px-8 pb-20 pt-10 min-[1200px]:px-11 min-[1200px]:pt-12 max-[599px]:px-5 max-[599px]:pb-12 max-[599px]:pt-7\" data-kid=\"2-2-1\" data-name=\"menu section\">\n            <div class=\"grid grid-cols-1 gap-10 min-[1024px]:grid-cols-[248px_minmax(0,1fr)] min-[1024px]:gap-9\" data-kid=\"2-2-1-1\" data-name=\"menu section grid\">\n                <aside class=\"min-[1024px]:pt-1\" data-kid=\"2-2-1-1-1\" data-name=\"menu sidebar\">\n                    <p class=\"mb-5 text-[12px] font-bold uppercase tracking-[.24em] text-[var(--logo-brown)]\" data-kid=\"2-2-1-1-1-1\" data-name=\"sidebar category label\">\n                        Menú\n                    </p>\n                    <div class=\"flex items-start gap-3\" data-kid=\"2-2-1-1-1-2\" data-name=\"sidebar header container\">\n                        <h1 class=\"ca-rye max-w-[245px] text-[50px] leading-[.99] text-[var(--espresso)] min-[1200px]:text-[55px] max-[599px]:text-[37px]\" data-kid=\"2-2-1-1-1-2-1\" data-name=\"sidebar main headline\" id=\"page-title\">\n                            Doce clásicos de la casa\n                        </h1>\n                        <span aria-hidden=\"true\" class=\"ca-rosette mt-2 max-[599px]:mt-1\" data-kid=\"2-2-1-1-1-2-2\" data-name=\"rosette decoration\">\n                            <span data-kid=\"2-2-1-1-1-2-2-1\" data-name=\"rosette petal\">\n                            </span>\n                            <span data-kid=\"2-2-1-1-1-2-2-2\" data-name=\"rosette petal\">\n                            </span>\n                            <span data-kid=\"2-2-1-1-1-2-2-3\" data-name=\"rosette petal\">\n                            </span>\n                            <span data-kid=\"2-2-1-1-1-2-2-4\" data-name=\"rosette petal\">\n                            </span>\n                        </span>\n                    </div>\n                    <p class=\"ca-ital mt-7 max-w-[230px] text-[36px] leading-[.95] text-[var(--logo-brown)] max-[599px]:mt-4 max-[599px]:text-[30px]\" data-kid=\"2-2-1-1-1-3\" data-name=\"sidebar secondary headline\">\n                        Preparados para disfrutar sin prisa\n                    </p>\n                    <dl class=\"mt-10 space-y-4 border-t border-[var(--logo-brown)]/30 pt-5 text-[16px] leading-tight text-[var(--espresso)] max-[599px]:mt-7 max-[599px]:grid max-[599px]:grid-cols-2 max-[599px]:gap-4 max-[599px]:space-y-0\" data-kid=\"2-2-1-1-1-4\" data-name=\"business info list\">\n                        <div data-kid=\"2-2-1-1-1-4-1\" data-name=\"address list item\">\n                            <dt class=\"text-[11px] font-bold uppercase tracking-[.18em] text-[var(--logo-brown)]\" data-kid=\"2-2-1-1-1-4-1-1\" data-name=\"address label\">\n                                Dirección\n                            </dt>\n                            <dd class=\"mt-1\" data-kid=\"2-2-1-1-1-4-1-2\" data-name=\"address value\">\n                                Calle 5 No. 13 - 177\n                            </dd>\n                        </div>\n                        <div data-kid=\"2-2-1-1-1-4-2\" data-name=\"hours list item\">\n                            <dt class=\"text-[11px] font-bold uppercase tracking-[.18em] text-[var(--logo-brown)]\" data-kid=\"2-2-1-1-1-4-2-1\" data-name=\"hours label\">\n                                Horario\n                            </dt>\n                            <dd class=\"mt-1\" data-kid=\"2-2-1-1-1-4-2-2\" data-name=\"hours value\">\n                                Todos los días · 8am–8pm\n                            </dd>\n                        </div>\n                    </dl>\n                </aside>\n                <div class=\"min-w-0\" data-kid=\"2-2-1-1-2\" data-name=\"product grid container\">\n                    <div class=\"ca-category-rule mb-5\" data-kid=\"2-2-1-1-2-1\" data-name=\"category header\">\n                        <span class=\"text-[12px] font-bold tracking-[.22em] text-[var(--logo-brown)]\" data-kid=\"2-2-1-1-2-1-1\" data-name=\"category number\">\n                            01\n                        </span>\n                        <h2 class=\"ca-rye text-[29px] leading-none text-[var(--espresso)]\" data-kid=\"2-2-1-1-2-1-2\" data-name=\"category title\">\n                            Cafés\n                        </h2>\n                        <span aria-hidden=\"true\" class=\"ca-rosette scale-[.62]\" data-kid=\"2-2-1-1-2-1-3\" data-name=\"category rosette decoration\">\n                            <span data-kid=\"2-2-1-1-2-1-3-1\" data-name=\"rosette petal\">\n                            </span>\n                            <span data-kid=\"2-2-1-1-2-1-3-2\" data-name=\"rosette petal\">\n                            </span>\n                            <span data-kid=\"2-2-1-1-2-1-3-3\" data-name=\"rosette petal\">\n                            </span>\n                            <span data-kid=\"2-2-1-1-2-1-3-4\" data-name=\"rosette petal\">\n                            </span>\n                        </span>\n                    </div>\n                    <div class=\"ca-product-grid\" data-kid=\"2-2-1-1-2-2\" data-name=\"product tile list\">\n                        <article class=\"ca-product-tile group p-3 max-[599px]:p-2.5\" data-kid=\"2-2-1-1-2-2-1\" data-name=\"product tile\" data-product=\"Espresso\">\n                            <div class=\"ca-photo-frame ca-arch\" data-image-frame=\"\" data-kid=\"2-2-1-1-2-2-1-1\" data-name=\"product photo frame\">\n                                <img alt=\"Espresso en taza artesanal — Raymond Petrik on Pexels\" data-kid=\"2-2-1-1-2-2-1-1-1\" data-name=\"product image\" decoding=\"async\" fetchpriority=\"high\" loading=\"lazy\" src=\"https://images.pexels.com/photos/30597790/pexels-photo-30597790.jpeg?auto=compress&cs=tinysrgb&w=720&q=80\"/>\n                                <span class=\"hidden text-center text-[13px] font-bold\" data-fallback=\"\" data-kid=\"2-2-1-1-2-2-1-1-2\" data-name=\"product image fallback\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-coffee mr-1\" data-kid=\"2-2-1-1-2-2-1-1-2-1\" data-name=\"coffee icon\">\n                                    </i>\n                                    Espresso\n                                </span>\n                            </div>\n                            <div class=\"ca-card-copy flex min-h-[154px] flex-col pt-3 max-[599px]:min-h-0 max-[599px]:pt-0\" data-kid=\"2-2-1-1-2-2-1-2\" data-name=\"product details\">\n                                <div class=\"flex items-start justify-between gap-2\" data-kid=\"2-2-1-1-2-2-1-2-1\" data-name=\"product title container\">\n                                    <h3 class=\"ca-rye text-[20px] leading-[1.05] text-[var(--espresso)]\" data-kid=\"2-2-1-1-2-2-1-2-1-1\" data-name=\"product title\">\n                                        Espresso\n                                    </h3>\n                                </div>\n                                <p class=\"ca-summary mt-2 text-[16px] leading-[1.18] text-[var(--ink)]\" data-kid=\"2-2-1-1-2-2-1-2-2\" data-name=\"product summary\">\n                                    Concentrado, aromático y con un final ligeramente caramelizado.\n                                </p>\n                                <div class=\"ca-card-actions mt-auto flex items-center justify-between gap-2 pt-4 max-[599px]:pt-0\" data-kid=\"2-2-1-1-2-2-1-2-3\" data-name=\"product action container\">\n                                    <span class=\"ca-price ca-tabular bg-[var(--yellow)] px-2.5 py-1.5 text-[16px] font-bold text-[var(--espresso)]\" data-kid=\"2-2-1-1-2-2-1-2-3-1\" data-name=\"product price\">\n                                        $7.000\n                                    </span>\n                                    <button aria-label=\"Ver más sobre Espresso\" class=\"ca-action flex items-center gap-1 bg-[var(--terracotta)] px-3 py-2 text-[15px] font-bold text-[var(--cream)] hover:bg-[var(--espresso)] focus-visible:outline-3 focus-visible:outline-[var(--yellow)] focus-visible:outline-offset-3\" data-kid=\"2-2-1-1-2-2-1-2-3-2\" data-name=\"view product details button\" data-open-product=\"Espresso\" type=\"button\">\n                                        Ver más\n                                        <i aria-hidden=\"true\" class=\"ti ti-arrow-right ca-action-arrow\" data-kid=\"2-2-1-1-2-2-1-2-3-2-1\" data-name=\"action arrow icon\">\n                                        </i>\n                                    </button>\n                                </div>\n                            </div>\n                        </article>\n                        <article class=\"ca-product-tile group p-3 max-[599px]:p-2.5 min-[1120px]:translate-y-[18px]\" data-kid=\"2-2-1-1-2-2-2\" data-name